# Security headers for every page, applied by Cloudflare Pages.
# Content-Security-Policy: everything comes from the site itself, except
#   - YouTube and Facebook players for the live stream (frame-src)
#   - the Google Apps Script that saves the forms, once googleScriptUrl is set (connect-src);
#     Google answers from script.googleusercontent.com, so both addresses are needed
#   - inline styles, because the pages use style="..." attributes
#   - Cloudflare Web Analytics, which Cloudflare adds to the pages on www.gardensrfc.com: its script
#     (static.cloudflareinsights.com) and where it sends the visit counts (cloudflareinsights.com)
#
# Cache-Control: browsers and other caches check for a newer copy on every visit (a quick "has it changed?"
# question), so a change to the site is never hidden behind an old copy. make_deploy.py also puts a version
# fingerprint on every script and stylesheet link for the same reason.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), midi=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com https://cloudflareinsights.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://www.facebook.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
